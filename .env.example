# Public local-demo values only. Do not put real credentials in this file.
# Copy to ignored .env for local changes; never reuse these passwords on a server.
POSTGRES_DB=event_platform
POSTGRES_USER=event_platform_user
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_HOST_PORT=5432
# Used by local dotnet run / dotnet ef; keep in sync with POSTGRES_* above.
JOBS_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=event_platform;Username=event_platform_user;Password=change_me_for_local_dev
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=jobs.submitted
RABBITMQ_DLQ_NAME=jobs.submitted.dlq
RABBITMQ_PREFETCH=4
AI_SERVICE_BASE_URL=http://localhost:8000
AI_PROVIDER=stub
# ANTHROPIC_API_KEY only needed when AI_PROVIDER=anthropic (optional; stub is free)
ANTHROPIC_API_KEY=
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_TOKENS=10
RATE_LIMIT_WINDOW_SECONDS=60
OUTBOX_POLL_SECONDS=2
